# ==========================================================
#  Websocket / SSH public_html config
#  Dipakai oleh: ssh/ssh-vpn.sh (baris 146)
#  Tujuan: melayani endpoint websocket untuk SSH & Xray
#          di belakang nginx tanpa mengekspos direktori.
# ==========================================================

# Jangan tampilkan isi direktori
Options -Indexes +FollowSymLinks

# Blokir akses langsung ke file konfigurasi / sensitif
<FilesMatch "\.(conf|config|ini|log|sh|py|key|pem|env)$">
    Require all denied
</FilesMatch>

# Sembunyikan file dotfile (.htaccess, .env, .git, dll)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Cegah akses ke folder version control bila ada
RedirectMatch 404 /\.git

# Header dasar
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "no-referrer"
</IfModule>

# Kompresi teks
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/css application/javascript application/json
</IfModule>

# Cache aset statis
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
</IfModule>

# Websocket tidak butuh rewrite khusus: nginx meneruskan
# Upgrade header langsung ke backend. Aturan di bawah hanya
# memastikan index.html tetap jadi halaman default.
DirectoryIndex index.html index.php
