<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8" />
<title>EKO BELLICK PREMIUM — Premium VPN Server</title>
<meta name="description" content="EKO BELLICK PREMIUM — akun SSH, VMESS, VLESS, TROJAN dengan koneksi stabil dan cepat." />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<meta name="theme-color" content="#08090d" />
<style>
:root{
  --bg:#08090d;
  --bg2:#0d1017;
  --card:#11141c;
  --line:#252b3a;
  --txt:#e8edf5;
  --dim:#c2cbdb;
  --dim2:#95a0b5;
  --acc:#39d98a;
  --acc2:#2bb673;
  --glow:rgba(57,217,138,.14);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{min-height:100%}
body{
  min-height:100vh;
  min-height:100dvh;
  background:var(--bg);
  color:var(--txt);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Ubuntu,sans-serif;
  line-height:1.6;
  display:flex;flex-direction:column;align-items:center;
  padding:calc(env(safe-area-inset-top,0px) + 0px) 18px calc(env(safe-area-inset-bottom,0px) + 20px);
  overflow-x:hidden;
  position:relative;
}
/* cahaya latar */
body::before{
  content:"";position:fixed;top:-180px;left:50%;transform:translateX(-50%);
  width:560px;height:560px;border-radius:50%;
  background:radial-gradient(circle,var(--glow) 0%,transparent 68%);
  pointer-events:none;z-index:0;
}
.wrap{width:100%;max-width:480px;position:relative;z-index:1;display:flex;flex-direction:column;flex:1 1 auto}
.wrap > footer{margin-top:26px}

/* ---------- header ---------- */
header{
  text-align:center;padding:30px 0 22px;
}
.logo{
  display:inline-flex;align-items:center;justify-content:center;
  width:56px;height:56px;border-radius:16px;
  background:linear-gradient(145deg,#1a3d2c,#0f1f18);
  border:1px solid #2a5c42;
  box-shadow:0 8px 24px rgba(57,217,138,.16),inset 0 1px 0 rgba(255,255,255,.06);
  margin-bottom:14px;
}
.logo svg{width:28px;height:28px;stroke:var(--acc);fill:none;stroke-width:1.8;
  stroke-linecap:round;stroke-linejoin:round}
h1{
  font-size:19px;font-weight:700;letter-spacing:1.4px;
  background:linear-gradient(180deg,#fff,#9fb3a8);
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;
  margin-bottom:4px;
}
.sub{font-size:11px;letter-spacing:2.6px;color:#9ba6bb;text-transform:uppercase}

/* ---------- status pill ---------- */
.status{
  display:inline-flex;align-items:center;gap:7px;
  margin-top:16px;padding:6px 13px;border-radius:100px;
  background:rgba(57,217,138,.08);
  border:1px solid rgba(57,217,138,.22);
  font-size:11.5px;color:#5ee6a3;font-weight:600;
}
.dot{
  width:6px;height:6px;border-radius:50%;background:var(--acc);
  box-shadow:0 0 0 0 rgba(57,217,138,.6);
  animation:pulse 2s infinite;
}
@keyframes pulse{
  0%{box-shadow:0 0 0 0 rgba(57,217,138,.55)}
  70%{box-shadow:0 0 0 8px rgba(57,217,138,0)}
  100%{box-shadow:0 0 0 0 rgba(57,217,138,0)}
}

/* ---------- kartu layanan ---------- */
.section-label{
  font-size:10.5px;letter-spacing:2.2px;color:#9ba6bb;
  text-transform:uppercase;margin:30px 0 13px;padding-left:2px;
}
ul{list-style:none;display:grid;gap:10px}
li{
  flex-shrink:0;
  background:linear-gradient(160deg,var(--card),#0c0f15);
  border:1px solid var(--line);
  border-radius:14px;
  padding:15px 16px;
  display:flex;align-items:center;gap:13px;
  transition:border-color .25s,transform .25s,box-shadow .25s;
  position:relative;overflow:hidden;
}
li::after{
  content:"";position:absolute;inset:0;border-radius:14px;
  background:linear-gradient(120deg,transparent 30%,rgba(57,217,138,.05) 50%,transparent 70%);
  opacity:0;transition:opacity .3s;pointer-events:none;
}
li:hover{border-color:#2a5c42;transform:translateY(-2px);box-shadow:0 8px 22px rgba(0,0,0,.35)}
li:hover::after{opacity:1}
.ico{
  flex:0 0 38px;height:38px;border-radius:11px;
  display:flex;align-items:center;justify-content:center;
  background:rgba(57,217,138,.07);
  border:1px solid rgba(57,217,138,.16);
}
.ico svg{width:18px;height:18px;stroke:var(--acc);fill:none;stroke-width:1.7;
  stroke-linecap:round;stroke-linejoin:round}
.meta{flex:1;min-width:0}
.name{font-size:14px;font-weight:650;letter-spacing:.6px;color:var(--txt)}
.desc{font-size:11.5px;color:var(--dim);margin-top:1px}
.badge{
  font-size:9px;font-weight:700;letter-spacing:.5px;
  padding:4px 2px;border-radius:6px;
  width:70px;flex:0 0 70px;text-align:center;
  background:rgba(57,217,138,.1);color:var(--acc);
  border:1px solid rgba(57,217,138,.2);
  white-space:nowrap;flex-shrink:0;
}

/* ---------- CTA ---------- */
.cta{
  display:flex;align-items:center;justify-content:center;gap:9px;
  margin-top:26px;padding:15px 20px;
  background:linear-gradient(135deg,var(--acc),var(--acc2));
  color:#04140c;text-decoration:none;
  border-radius:13px;font-weight:750;font-size:14px;letter-spacing:.3px;
  box-shadow:0 4px 16px rgba(57,217,138,.18);
  transition:transform .2s,box-shadow .2s;
}
.cta:active{transform:scale(.975);box-shadow:0 4px 16px rgba(57,217,138,.3)}
.cta svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round}

/* ---------- trust ---------- */
.trust{
  display:flex;flex-wrap:wrap;justify-content:center;gap:7px 15px;
  margin-top:20px;padding:0 2px;
}
.trust span{
  display:inline-flex;align-items:center;gap:5px;
  font-size:11.5px;color:#96a1b5;white-space:nowrap;
}
.trust svg{width:12px;height:12px;stroke:var(--acc);fill:none;stroke-width:2.4;
  stroke-linecap:round;stroke-linejoin:round;opacity:.85}

/* ---------- footer ---------- */
footer{
  margin-top:26px;padding-top:4px;text-align:center;
}
footer::before{
  content:"";display:block;width:64px;height:1px;margin:0 auto 14px;
  background:linear-gradient(90deg,transparent,var(--line),transparent);
}
footer .brand{font-size:12px;color:#a3adc0;letter-spacing:1.4px;font-weight:600}
footer .tg{
  display:inline-flex;align-items:center;gap:6px;
  margin-top:9px;font-size:12px;color:var(--dim);
  text-decoration:none;padding:8px 12px;border-radius:8px;
}
footer .tg svg{width:14px;height:14px;stroke:#39d98a;fill:none;stroke-width:1.7;opacity:.8}
footer .tg{color:#aab4c7}
footer .tg:hover{color:var(--acc)}
footer .tg:hover svg{stroke:var(--acc)}

/* scrollbar bertema */
::-webkit-scrollbar{width:8px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:#232a38;border-radius:8px}
::-webkit-scrollbar-thumb:hover{background:#2e3748}

/* jarak hero lebih rapat */
header{padding:26px 0 18px}
.status{margin-top:14px}
.section-label{margin:22px 0 12px}

/* ikon & badge sedikit lebih besar */
.ico{flex:0 0 42px;height:42px;border-radius:12px}
.ico svg{width:20px;height:20px}
.badge{font-size:10px;padding:4px 8px}
.desc{font-size:12px}

/* fade bawah sebagai penanda scroll */
body::after{
  content:"";position:fixed;left:0;right:0;bottom:0;height:64px;
  background:linear-gradient(to top,var(--bg) 10%,transparent);
  pointer-events:none;z-index:2;
}
</style>
</head>
